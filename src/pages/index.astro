---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Jed Li"
  description="I'm a PhD candidate at Monash University working on scalable methods for semidefinite programming."
>
  <section class="hero">
    <div>
      <p class="eyebrow">Monash University · Melbourne</p>
      <h1>Jed Li</h1>
      <p class="role"><strong>PhD Candidate</strong><br />Department of Electrical and Computer Systems Engineering</p>
      <p class="lead">I work on scalable methods for <em>semidefinite programming</em>.</p>
    </div>

    <div class="matrix" aria-label="Stylised block tridiagonal Toeplitz matrix sparsity pattern" role="img">
      {Array.from({ length: 36 }, (_, i) => {
        const r = Math.floor(i / 6);
        const c = i % 6;
        const cls =
          r === c ? "diag" : c - r === 1 ? "upper" : r - c === 1 ? "lower" : "empty";
        const delay = (0.12 + (r + c) * 0.045).toFixed(2);
        return <span class={cls} style={`animation-delay:${delay}s`}></span>;
      })}
      <small>block tridiagonal Toeplitz structure</small>
    </div>
  </section>

  <section class="home-section">
    <p class="eyebrow">About</p>
    <h2>About me</h2>
    <blockquote class="quote"><p>"Good morning, starshine. The Earth says hello!"</p><cite>— Willy Wonka</cite></blockquote>
    <p>I'm Jed, a first-year PhD student at Monash University, where I am under the invaluable guidance of my main supervisor James Saunderson, and my co-supervisor Hamza Fawzi.</p>
    <p>Broadly speaking, my chief research interests lie in mathematical optimisation and its applications (machine learning, optimal control, finance, you name it!) I'm also drawn to the algorithms and modelling behind robotics, from autonomous vehicles to mobile robotic systems more generally.</p>
    <p>In my spare time, I enjoy playing video games, particularly the aspects of game theory and the formulation of tactics and strategies in video games. I tinker with code for small robotic projects, and disappear down occasional mathematical rabbit holes.</p>
  </section>

  <section class="home-section">
    <p class="eyebrow">Contact</p>
    <h2>Get in touch</h2>
    <div class="links">
      <span class="email">jed [dot] li [at] monash [dot] edu</span>
      <a class="icon-link" href="https://github.com/mcdonaldshappymeal" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.205 11.387.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.386-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.238 1.84 1.238 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.605-2.665-.303-5.467-1.332-5.467-5.93 0-1.31.469-2.381 1.236-3.221-.124-.303-.535-1.523.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.984-.399 3.005-.404 1.02.005 2.047.138 3.006.404 2.29-1.553 3.297-1.23 3.297-1.23.653 1.653.242 2.873.119 3.176.77.84 1.235 1.911 1.235 3.221 0 4.61-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 21.796 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </a>
      <a class="icon-link" href="https://www.linkedin.com/in/jed-li" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a class="icon-link" href="https://www.monash.edu/engineering/jedli" aria-label="Monash University profile">
        <span class="monash-mark"></span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,6vw,5rem);align-items:center;padding-block:clamp(1rem,5vw,4rem) clamp(4rem,9vw,7rem)}
  .eyebrow{margin:0 0 1rem;color:var(--accent);font-family:var(--font-mono);font-size:.72rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}
  h1{margin:0 0 1.15rem}.role{margin:0 0 2.4rem;color:var(--text-muted);line-height:1.55}.role strong{color:var(--text)}
  .lead{max-width:26ch;margin:0 0 1.6rem;font-family:var(--font-display);font-size:clamp(1.6rem,3vw,2.15rem);line-height:1.36}.lead em{color:var(--accent)}
  .matrix{width:min(100%,330px);justify-self:end;display:grid;grid-template-columns:repeat(6,1fr);gap:7px}.matrix span{aspect-ratio:1;border:1px solid var(--border);border-radius:5px}.matrix .diag{background:var(--accent-deep);border-color:transparent}.matrix .upper{background:linear-gradient(45deg,color-mix(in srgb,var(--accent-secondary) 16%,transparent) 50%,var(--accent-secondary) 50%);border-color:transparent}.matrix .lower{background:linear-gradient(45deg,var(--accent-secondary) 50%,color-mix(in srgb,var(--accent-secondary) 16%,transparent) 50%);border-color:transparent}.matrix small{grid-column:1/-1;margin-top:.8rem;color:var(--text-dim);font-family:var(--font-mono);font-size:.65rem;text-align:center}
  @media (prefers-reduced-motion:no-preference){.matrix .diag,.matrix .upper,.matrix .lower{opacity:0;animation:mxIn .55s cubic-bezier(.2,.75,.2,1) forwards}}
  @keyframes mxIn{from{opacity:0;transform:scale(.55)}to{opacity:1;transform:scale(1)}}
  .home-section{padding-block:3.8rem;border-top:1px solid var(--border)}.home-section h2{margin:0 0 1.5rem}.home-section p{color:var(--text-muted)}
  .quote{margin:0 0 2rem;padding-left:1.1rem;border-left:2px solid var(--accent)}
  .quote p{margin:0 0 .5rem;color:var(--text);font-family:var(--font-display);font-style:italic;font-size:1.5rem;line-height:1.3}
  .quote cite{display:block;color:var(--text-dim);font-family:var(--font-mono);font-size:.72rem;font-style:normal;letter-spacing:.04em}
  .links{display:flex;gap:.8rem 1.3rem;flex-wrap:wrap;align-items:center}.links .email{color:var(--text-muted);font-family:var(--font-mono);font-size:.92rem}
  .icon-link{display:inline-flex;align-items:center;color:var(--text-muted);transition:color .16s ease}.icon-link:hover{color:var(--accent);text-decoration:none}.icon-link svg{display:block;fill:currentColor}
  .monash-mark{display:block;width:14px;height:20px;background:currentColor;-webkit-mask:url(/monash-mark.png) center/contain no-repeat;mask:url(/monash-mark.png) center/contain no-repeat}
  @media(max-width:760px){.hero{grid-template-columns:1fr}.matrix{order:-1;width:210px;justify-self:start}.matrix small{text-align:left}}
</style>
